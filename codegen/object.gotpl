
{{- if $.Config.Exec.IsTable }}
{{- template "tableGroups" $ }}
{{- end }}
{{- range $object := .Objects }}
{{- if $.Config.Exec.IsTable }}
{{- template "tableSubscription" (dict "Data" $ "Object" $object) }}
{{- else }}

var {{ $object.Name|lcFirst}}Implementors = {{$object.Implementors}}

{{- if .Stream }}
{{- if $object.HasSubscriptionContextField }}
func {{$.FuncReceiver}}_{{$object.Name}}(ctx context.Context, {{$.ECFuncParam}}sel ast.SelectionSet) func(ctx context.Context) (context.Context, graphql.Marshaler) {
	fields := graphql.CollectFields(ec.OperationContext, sel, {{$object.Name|lcFirst}}Implementors)
	ctx = graphql.WithFieldContext(ctx, &graphql.FieldContext{
		Object: {{$object.Name|quote}},
	})
	if len(fields) != 1 {
		graphql.AddErrorf(ctx, "must subscribe to exactly one stream")
		return nil
	}

	switch fields[0].Name {
	{{- range $field := $object.Fields }}
	case "{{$field.Name}}":
		{{- if $field.UsesSubscriptionContext }}
		return {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}fields[0])
		{{- else }}
		return graphql.StreamWithoutEventContext({{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}fields[0]))
		{{- end }}
	{{- end }}
	default:
		panic("unknown field " + strconv.Quote(fields[0].Name))
	}
}
{{- else }}
func {{$.FuncReceiver}}_{{$object.Name}}(ctx context.Context, {{$.ECFuncParam}}sel ast.SelectionSet) func(ctx context.Context) graphql.Marshaler {
	fields := graphql.CollectFields(ec.OperationContext, sel, {{$object.Name|lcFirst}}Implementors)
	ctx = graphql.WithFieldContext(ctx, &graphql.FieldContext{
		Object: {{$object.Name|quote}},
	})
	if len(fields) != 1 {
		graphql.AddErrorf(ctx, "must subscribe to exactly one stream")
		return nil
	}

	switch fields[0].Name {
	{{- range $field := $object.Fields }}
	case "{{$field.Name}}":
		return {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}fields[0])
	{{- end }}
	default:
		panic("unknown field " + strconv.Quote(fields[0].Name))
	}
}
{{- end }}
{{- else }}

func {{$.FuncReceiver}}_{{$object.Name}}(ctx context.Context, {{$.ECFuncParam}}sel ast.SelectionSet{{ if not $object.Root }},obj {{$object.Reference | ref }}{{ end }}) graphql.Marshaler {
	fields := graphql.CollectFields(ec.OperationContext, sel, {{$object.Name|lcFirst}}Implementors)
	{{- if $object.Root }}
		ctx = graphql.WithFieldContext(ctx, &graphql.FieldContext{
			Object: {{$object.Name|quote}},
		})
	{{end}}

	out := graphql.NewFieldSet(fields)
	deferred := graphql.NewDeferredGroup(ctx)
	for i, field := range fields {
		{{- if $object.Root }}
			innerCtx := graphql.WithRootFieldContext(ctx, &graphql.RootFieldContext{
				Object: field.Name,
				Field: field,
			})
		{{end}}
		switch field.Name {
		case "__typename":
			out.Values[i] = graphql.MarshalString({{$object.Name|quote}})
		{{- range $field := $object.Fields }}
		case "{{$field.Name}}":
			{{- if $field.IsConcurrent }}
				{{- if $object.Root }}
					out.ResolveRootConcurrently(innerCtx, ec.OperationContext, i,
						{{ not $.Config.OmitPanicHandler }}, {{ $field.TypeReference.GQL.NonNull }},
						func(ctx context.Context) graphql.Marshaler {
							return {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}field)
						})
				{{- else }}
					out.ResolveConcurrently(ec.OperationContext, &deferred, i,
						{{ not $.Config.OmitPanicHandler }}, {{ $field.TypeReference.GQL.NonNull }},
						func(ctx context.Context) graphql.Marshaler {
							return {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}field, obj)
						})
				{{- end }}
			{{- else }}
				{{- if $object.Root -}}
					out.Values[i] = ec.OperationContext.RootResolverMiddleware(innerCtx, func(ctx context.Context) (res graphql.Marshaler) {
						return {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}field)
					})
				{{- else -}}
					out.Values[i] = {{$.ECDot}}_{{$object.Name}}_{{$field.Name}}(ctx, {{$.ECArg}}field, obj)
				{{- end -}}

				{{- if $field.TypeReference.GQL.NonNull }}
					if out.Values[i] == graphql.Null { {{ $object.InvalidsIncrement "out" }} }
				{{- else }}
					if out.Values[i] == graphql.RequiredNull { {{ $object.InvalidsIncrement "out" }} }
				{{- end }}
			{{- end }}
		{{- end }}
		default:
			panic("unknown field " + strconv.Quote(field.Name))
		}
	}
	out.Dispatch(ctx)
	if out.Invalids > 0 { return graphql.Null }

	{{/*
	   The guard looks redundant, because ProcessDeferredGroup already returns
	   early on an empty group. It is here for the atomic add above it: see the
	   Deferred field on graphql.ExecutionContextState for why.

	   A template comment, which emits nothing, rather than a generated one.
	   This block is written once per object, so four lines of prose here cost
	   2,908 lines across the generated files, and the explanation belongs
	   with the counter rather than with each of its hundreds of call sites.
	*/ -}}
	if n := len(deferred.Defers); n > 0 {
		atomic.AddInt32(&ec.Deferred, int32(min(n, math.MaxInt32)))
		ec.ProcessDeferredGroup(deferred)
	}

	return out
}
{{- end }}

{{- end }}
{{- end }}

{{- /* tableGroups builds the tables of the objects and inputs of the file, a group of
   them per function, and writes the function of each table after the group. */}}
{{- define "tableGroups" }}
{{- $data := . }}
{{- range $group := $data.TableInitGroups }}

func (t *tables) init{{ (index $group 0).TableVar | ucFirst }}() {
	{{- range $o := $group }}
	{{- if eq $o.Kind "INPUT_OBJECT" }}
	{{- template "tableInput" (dict "Data" $data "Input" $o) }}
	{{- else }}
	{{- template "tableObject" (dict "Data" $data "Object" $o) }}
	{{- end }}
	{{- end }}
}
{{- range $o := $group }}
{{- if eq $o.Kind "INPUT_OBJECT" }}
{{- template "tableInputSet" (dict "Data" $data "Input" $o) }}
{{- else }}
{{- template "tableObjectResolve" (dict "Data" $data "Object" $o) }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

{{- define "tableObject" }}
{{- $data := .Data }}
{{- $object := .Object }}
	t.{{ $object.TableVar }}.Init(t.schema, {{ $object.Name | quote }}, {{ $object.TableFunc }}, []tableField{
	{{- range $field := $object.Fields }}
		{{- $entry := dict "Data" $data "Field" $field }}
		{ {{- template "tableFieldEntry" $entry -}} , {{ $data.TableOutEntry $field.TypeReference }}
		{{- if $object.Stream }}, Stream: exec.{{ if $field.UsesSubscriptionContext }}Event{{ end }}StreamOf[{{ $field.TypeReference.GO | ref }}](){{ end }}},
	{{- end }}
	})
{{- end }}

{{- /* tableObjectResolve writes the exec.Resolve of an object, which resolves its fields
   by their index in the table: one function for the object rather than a closure per
   field, as what the compiler spends on a package grows with the number of its
   functions. */}}
{{- define "tableObjectResolve" }}
{{- $object := .Object }}
{{- /* The object is asserted to its Go type once, before the switch, rather than in each
   case. */}}
{{- /* The parameters have names that a package of the Go types the function refers to
   is unlikely to have, which they would hide. */}}
{{- $param := "_" }}
{{- if $object.TableReadsObject }}{{ $param = "o" }}{{ end }}

func {{ $object.TableFunc }}(ctx context.Context, ec *executionContext, {{ $param }} any, fieldIndex int, fieldArgs map[string]any) (any, error) {
	{{- if $object.TableReadsObject }}
	obj := o.({{ $object.Reference | ref }})
	{{- end }}
	switch fieldIndex {
	{{- range $i, $field := $object.Fields }}
	case {{ $i }}:
		{{- /* A field read from its object declares the value with the Go type of the
		   field's marshaler before it returns it as any, so that the compiler checks that
		   the field has the type the marshaler marshals, as the typed call of the
		   functions mode does. */}}
		{{- $get := $field.TableGetExpr }}
		{{- /* A field of a root operation type resolves to a fresh value of the type. */}}
		{{- $root := "" }}
		{{- if $field.TypeReference.IsRoot }}
			{{- $get = "" }}
			{{- if $field.TypeReference.IsPtr }}{{ $root = printf "&%s{}" ($field.TypeReference.Elem.GO | ref) }}
			{{- else }}{{ $root = printf "%s{}" ($field.TypeReference.GO | ref) }}{{ end }}
		{{- end }}
		{{- $body := $field.TableResolveBody }}
		{{- if $get }}
		var v {{ $field.TypeReference.GO | ref }} = {{ $get }}
		return v, nil
		{{- else if $root }}
		return {{ $root }}, nil
		{{- else if $body }}
		{{ $body }}
		{{- else }}
		{{- template "fieldDefinition" $field }}
		{{- end }}
	{{- end }}
	}
	return nil, exec.NoField(fieldIndex)
}
{{- end }}

{{- /* tableFieldEntry writes the entries of a field that every field has: its name and
   what ties it to Go. The runtime reads the rest, such as its type and directives, from
   the schema. */}}
{{- define "tableFieldEntry" -}}
{{- $data := .Data }}
{{- $field := .Field -}}
Name: {{ $field.Name | quote }}
{{- if $field.IsResolver }}, IsResolver: true
{{- else }}
{{- if $field.IsConcurrent }}, Concurrent: true{{ end }}
{{- if $field.IsMethod }}, IsMethod: true{{ end }}
{{- end }}
{{- if $field.Arguments }}, Args: {{ $data.TableFieldIns $field }}
{{- with $data.TableArgOrder $field }}, ArgOrder: {{ . }}{{ end }}
{{- end }}
{{- end }}

{{- define "tableSubscription" }}
{{- $data := .Data }}
{{- $object := .Object }}
{{- if $object.Stream }}

{{- /* The subscription keeps the function of the functions mode, which the generated
   Exec, the subscription middleware and the marshaler of the root type call. */}}
{{- if $object.HasSubscriptionContextField }}

func _{{ $object.Name }}(ctx context.Context, {{ $data.ECFuncParam }}sel ast.SelectionSet) func(ctx context.Context) (context.Context, graphql.Marshaler) {
	return ec.tables.{{ $object.TableVar }}.SubscribeWithEventContext(ctx, ec, sel)
}
{{- else }}

func _{{ $object.Name }}(ctx context.Context, {{ $data.ECFuncParam }}sel ast.SelectionSet) func(ctx context.Context) graphql.Marshaler {
	return ec.tables.{{ $object.TableVar }}.Subscribe(ctx, ec, sel)
}
{{- end }}
{{- end }}
{{- end }}
