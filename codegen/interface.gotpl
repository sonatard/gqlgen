{{- range $interface := .Interfaces }}

func {{$.FuncReceiver}}_{{$interface.Name}}(ctx context.Context, {{$.ECFuncParam}}sel ast.SelectionSet, obj {{$interface.Type | ref}}) graphql.Marshaler {
	switch obj := (obj).(type) {
	case nil:
		return graphql.Null
	{{- range $implementor := $interface.Implementors }}
		case {{$implementor.Type | ref}}:
			{{- if $implementor.CanBeNil }}
				if obj == nil {
					return graphql.Null
				}
			{{- end }}
			{{- $obj := "obj" }}
			{{- if $implementor.TakeRef }}{{ $obj = "&obj" }}{{ end }}
			{{- if and $.Config.Exec.IsTable ($.TableChecksImplementor $implementor) }}
				{{- /* The table takes the object as any. The functions mode passes it in
				   this Go type, so that an implementation it cannot take fails to compile
				   in the same way. */}}
				var o {{ $.TableObjectReference $implementor.Name | ref }} = {{ $obj }}
				return {{ $.ObjectMarshal $implementor.Name "sel" "o" }}
			{{- else }}
			return {{ $.ObjectMarshal $implementor.Name "sel" $obj }}
			{{- end }}
	{{- end }}
	default:
		if typedObj, ok := obj.(graphql.Marshaler); ok {
			return typedObj
		} else {
			panic(fmt.Errorf("unexpected type %T; non-generated variants of {{$interface.Name}} must implement graphql.Marshaler", obj))
		}
	}
}

{{- end }}
