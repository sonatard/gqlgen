{{- range $input := .Inputs }}
	{{- if not .HasUnmarshal }}
	{{- $it := "it" }}
	{{- if .PointersInUnmarshalInput }}
	  {{- $it = "&it" }}
	{{- end }}
	{{- if not $.Config.Exec.IsTable }}
	func {{$.FuncReceiver}}unmarshalInput{{ .Name }}(ctx context.Context, {{$.ECFuncParam}}obj any) ({{ if .PointersInUnmarshalInput }}*{{ end }}{{.Type | ref}}, error) {
		var it {{.Type | ref}}
		if obj == nil {
			return {{$it}}, nil
		}

		asMap := map[string]any{}
		for k, v := range obj.(map[string]any) {
			asMap[k] = v
		}
		{{ range $field := .Fields}}
			{{- if notNil "Default" $field }}
				if _, present := asMap[{{$field.Name|quote}}] ; !present {
					asMap[{{$field.Name|quote}}] = {{ $field.Default | dump }}
				}
			{{- end}}
		{{- end }}

		fieldsInOrder := [...]string{ {{ range .Fields }}{{ quote .Name }},{{ end }} }
		{{- if $input.IsMap }}
			it = make(map[string]any, len(asMap))
		{{- end }}
		for _, k := range fieldsInOrder {
			v, ok := asMap[k]
			if !ok {
				continue
			}
			switch k {
			{{- range $field := .Fields }}
			case {{$field.Name|quote}}:
				{{- $lhs := (printf "it.%s" $field.GoFieldName) }}
				{{- if $input.IsMap }}
					{{- $lhs = (printf "it[%q]" $field.Name) }}
				{{- end }}
				ctx := graphql.WithPathContext(ctx, graphql.NewPathWithField({{$field.Name|quote}}))
				{{- if $field.ImplDirectives }}
					directive0 := func(ctx context.Context) (any, error) { return {{$.ECDot}}{{ $field.TypeReference.UnmarshalFunc }}(ctx, {{$.ECArg}}v) }
					{{ template "implDirectives" ($.ImplDirectivesCtx $field) }}
					tmp, err := directive{{$field.ImplDirectives|len}}(ctx)
					if err != nil {
						return {{$it}}, graphql.ErrorOnPath(ctx, err)
					}
					if data, ok := tmp.({{ $field.TypeReference.GO | ref }}) ; ok {
						{{- if $field.IsResolver }}
							if err = ec.Resolvers.{{ $field.ShortInvocation }}; err != nil {
								return {{$it}}, err
							}
						{{- else }}
							{{- if $field.TypeReference.IsOmittable }}
								{{ $lhs }} = graphql.OmittableOf(data)
							{{- else }}
								{{ $lhs }} = data
							{{- end }}
						{{- end }}
					{{- if $field.TypeReference.IsNilable }}
						{{- if not $field.IsResolver }}
						} else if tmp == nil {
							{{- if $field.TypeReference.IsOmittable }}
								{{ $lhs }} = graphql.OmittableOf[{{ $field.TypeReference.GO | ref }}](nil)
							{{- else }}
								{{ $lhs }} = nil
							{{- end }}
						{{- end }}
					{{- end }}
					} else {
						err := fmt.Errorf(`unexpected type %T from directive, should be {{ $field.TypeReference.GO }}`, tmp)
						return {{$it}}, graphql.ErrorOnPath(ctx, err)
					}
				{{- else }}
					{{- if $field.IsResolver }}
						data, err := {{$.ECDot}}{{ $field.TypeReference.UnmarshalFunc }}(ctx, {{$.ECArg}}v)
						if err != nil {
							return {{$it}}, err
						}
						if err = ec.Resolvers.{{ $field.ShortInvocation }}; err != nil {
							return {{$it}}, err
						}
					{{- else }}
						data, err := {{$.ECDot}}{{ $field.TypeReference.UnmarshalFunc }}(ctx, {{$.ECArg}}v)
						if err != nil {
							return {{$it}}, err
						}
						{{- if $field.TypeReference.IsOmittable }}
							{{ $lhs }} = graphql.OmittableOf(data)
						{{- else }}
							{{ $lhs }} = data
						{{- end }}
					{{- end }}
				{{- end }}
			{{- end }}
			}
		}

		{{- if $input.InputObjectDirectives }}
		// Execute INPUT_OBJECT level directives (e.g., @oneOf, @directive3)
		// These run after all fields have been unmarshaled
		directive0 := func(ctx context.Context) (any, error) { return {{$it}}, nil }
		{{ template "implDirectives" ($.InputObjectImplDirectivesCtx $input $it) }}
		tmp, err := directive{{$input.InputObjectDirectives|len}}(ctx)
		if err != nil {
			return {{$it}}, graphql.ErrorOnPath(ctx, err)
		}
		if data, ok := tmp.({{ if $input.PointersInUnmarshalInput }}*{{ end }}{{$input.Type | ref}}) ; ok {
			return data, nil
		}
		return {{$it}}, graphql.ErrorOnPath(ctx, fmt.Errorf(`unexpected type %T from INPUT_OBJECT directive, should be {{ if $input.PointersInUnmarshalInput }}*{{ end }}{{$input.Type | ref}}`, tmp))
		{{- else }}
		return {{$it}}, nil
		{{- end }}
	}
	{{- end }}

	{{- if and (not $.Config.OmitTypedInputUnmarshalers) $.Config.Exec.IsTable }}

	// Unmarshal{{ .Name }} unmarshals raw into the {{ .Name }} input type, as graphql.UnmarshalNamedInputFromContext does.
	func Unmarshal{{ .Name }}(ctx context.Context, raw any) (out {{ if .PointersInUnmarshalInput }}*{{ end }}{{.Type | ref}}, err error) {
		err = graphql.UnmarshalNamedInputFromContext(ctx, {{ .Name | quote }}, raw, &out)
		return out, err
	}
	{{- else if not $.Config.OmitTypedInputUnmarshalers }}

	// Unmarshal{{ .Name }} unmarshals raw into the {{ .Name }} input type, using the
	// unmarshaler bound to ctx's request. Call it from a resolver to decode an input
	// object that was not passed as a field argument.
	//
	// ctx must come from a gqlgen request; outside one there is no unmarshaler to use
	// and the returned error says so.
	func Unmarshal{{ .Name }}(ctx context.Context, raw any) ({{ if .PointersInUnmarshalInput }}*{{ end }}{{.Type | ref}}, error) {
		var out {{ if .PointersInUnmarshalInput }}*{{ end }}{{.Type | ref}}
		err := graphql.UnmarshalNamedInputFromContext(ctx, {{ .Name | quote }}, raw, &out)
		return out, err
	}
	{{- end }}
	{{- end }}
{{ end }}


{{- define "tableInput" }}
{{- $data := .Data }}
{{- $input := .Input }}
{{- $T := $input.Type | ref }}
	t.{{ $input.TableVar }}.Init(t.schema, exec.Input[*executionContext]{Name: {{ $input.Name | quote }}, GoType: {{ $T | quote }}, Type: reflect.TypeOf((*{{ $T }})(nil)).Elem()
	{{- if $input.PointersInUnmarshalInput }}, Pointer: true{{ end }}
	{{- if $input.IsMap }}, IsMap: true{{ end }}
	{{- if $input.TableSetsFields }}, Set: {{ $input.TableFunc }}{{ end }}}, []tableInputField{
	{{- range $field := $input.Fields }}
		{{- $entry := dict "Data" $data "Field" $field }}
		{{- if $field.IsResolver }}
		{ {{- template "tableInputEntry" $entry -}} , {{ $data.TableInEntry $field.TypeReference }}
		{{- with $data.TableInputGoType $field }}, GoType: {{ . | quote }}{{ end }}, SetWith: func(ctx context.Context, ec *executionContext, inputValue, v any) error {
				fieldValue, _ := v.({{ $field.TypeReference.GO | ref }})
				return ec.Resolvers.{{ $field.TableInputInvocation }}
			}},
		{{- else }}
		{ {{- template "tableInputEntry" $entry -}} , {{ $data.TableInEntry $field.TypeReference }}
		{{- with $data.TableInputGoType $field }}, GoType: {{ . | quote }}{{ end }}},
		{{- end }}
	{{- end }}
	})
{{- end }}

{{- /* tableInputSet writes the Set of an input, which stores its fields by their index in
   the table: one function for the input rather than a closure per field, as for the
   exec.Resolve of an object. It asserts the value,
   which the runtime passes as any, to the Go type of the field's unmarshaler, so that
   the compiler checks that the field has the type the unmarshaler unmarshals, as the
   typed call of the functions mode does. A nil stores the zero value. */}}
{{- define "tableInputSet" }}
{{- $input := .Input }}
{{- $T := $input.Type | ref }}
{{- if $input.TableSetsFields }}

func {{ $input.TableFunc }}(inputValue any, fieldIndex int, v any) {
	{{- if $input.IsMap }}
	m := *inputValue.(*map[string]any)
	{{- else }}
	p := inputValue.(*{{ $T }})
	{{- end }}
	switch fieldIndex {
	{{- range $i, $field := $input.Fields }}
	{{- if not $field.IsResolver }}
	{{- $V := $field.TypeReference.GO | ref }}
	case {{ $i }}:
		{{- if $input.IsMap }}
		m[{{ $field.Name | quote }}], _ = v.({{ $V }})
		{{- else if $field.TypeReference.IsOmittable }}
		x, _ := v.({{ $V }})
		p.{{ $field.GoFieldName }} = graphql.OmittableOf(x)
		{{- else }}
		p.{{ $field.GoFieldName }}, _ = v.({{ $V }})
		{{- end }}
	{{- end }}
	{{- end }}
	}
}
{{- end }}
{{- end }}

{{- /* tableInputEntry writes the entries of an input field that every field has: its
   name. The runtime reads its default and directives from the schema. */}}
{{- define "tableInputEntry" -}}
Name: {{ .Field.Name | quote }}
{{- end }}
